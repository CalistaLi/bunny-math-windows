{
  "name": "bunny-math",
  "private": true,
  "version": "0.1.0",
  "description": "Bunny Math offline Windows desktop application",
  "author": "Bunny Math contributors",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && node node_modules/electron/install.js && electron-builder --win --x64"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/mochiy-pop-one": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/canvas-confetti": "^1.9.0",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
